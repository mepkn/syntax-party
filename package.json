{
  "name": "syntax-party",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "setup:auth": "node scripts/setup-auth-keys.ts --apply",
    "deploy": "scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 scripts/deploy.sh"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@base-ui/react": "^1.9.0",
